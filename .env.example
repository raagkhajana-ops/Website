# Raag Khajana — form endpoints
# Copy this file to `.env` (never commit `.env`) and set the URLs below,
# or set them as environment variables in your host's dashboard
# (Netlify/Vercel/Cloudflare Pages). They are read at BUILD time.

# Newsletter form — receives POST {"email": "..."} as JSON.
# e.g. Formspree: https://formspree.io/f/yourFormId
#      Buttondown: https://api.buttondown.email/v1/subscribers (needs a proxy for the API key)
VITE_NEWSLETTER_ENDPOINT=""

# Contact form — receives POST {"name": "...", "email": "...", "message": "..."} as JSON.
# e.g. Formspree: https://formspree.io/f/yourOtherFormId
VITE_CONTACT_ENDPOINT=""

# Local testing without a real service (dev server only):
# VITE_NEWSLETTER_ENDPOINT="/__mock/newsletter"
# VITE_CONTACT_ENDPOINT="/__mock/contact"
# (POST /__mock/fail always returns 500, to preview the error state.)
